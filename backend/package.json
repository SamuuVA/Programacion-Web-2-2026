{
  "name": "@nexusmarket/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NexusMarket backend - first vertical slice (PI-01 RegisterBuyer)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:baseline": "tsx scripts/migrate.ts --baseline",
    "db:status": "tsx scripts/migrate.ts --status",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
