{
  "name": "@nexusmarket/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NexusMarket backend - first vertical slice (PI-01 RegisterBuyer)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "validate:openapi": "tsx scripts/validate-openapi.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:baseline": "tsx scripts/migrate.ts --baseline",
    "db:status": "tsx scripts/migrate.ts --status",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "smoke:seller": "tsx scripts/seller-smoke.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run validate:openapi && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
