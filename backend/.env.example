NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# memory: adaptador efímero para desarrollo/pruebas (sin PostgreSQL)
# postgres: persistencia autoritativa del primer vertical
PERSISTENCE=memory
DATABASE_URL=postgresql://nexusmarket:nexusmarket@127.0.0.1:5432/nexusmarket

# Solo para la suite PostgreSQL automatizada (`npm run test:postgres`).
# Debe apuntar a una base local cuyo nombre termine en `_test`.
TEST_DATABASE_URL=postgresql://nexusmarket:nexusmarket@127.0.0.1:5432/nexusmarket_test
